# MACOS files
.DS_Store

# Python bytecode/cache generated by packaging and documentation checks
__pycache__/
*.py[cod]

# CMake build folder
build/
cmake-build-*/

# build.sh output folder
out/

# Downloaded test corpora (managed by scripts/fetch-json-test-suite.sh)
.test-corpora/

# Optional third-party benchmark comparison sources
.benchmark-deps/

# Coverage-guided fuzz runtime state (committed seeds stay in fuzz/corpus/)
.fuzz-corpus/
.fuzz-artifacts/

# CMake artifacts (in case CMake is ever run in-source)
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
CTestTestfile.cmake
compile_commands.json
CMakeUserPresets.json
Makefile

#vscode settings
.vscode/
.idea/

# Editor backups and local logs
*~
*.swp
*.swo
*.log

# Prerequisites
*.d

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Fortran module files
*.mod
*.smod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app
