# JSON structure and literals
lbrace="{"
rbrace="}"
lbracket="["
rbracket="]"
colon=":"
comma=","
quote="\""
true="true"
false="false"
null="null"
unicode="\\u0000"

# Supported schema vocabulary
type="\"type\""
properties="\"properties\""
items="\"items\""
required="\"required\""
pattern="\"pattern\""
enum="\"enum\""
const="\"const\""
allof="\"allOf\""
anyof="\"anyOf\""
oneof="\"oneOf\""
not="\"not\""
