[libfuzzer]
# Bound generated inputs so routine mutations emphasize schema state coverage.
max_len = 65536
# Stop one schema/instance pair if validation exceeds five seconds.
timeout = 5
# Leave enough headroom for sanitizer overhead while catching runaway growth.
rss_limit_mb = 2048
